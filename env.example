# ---- Model (resume text is sent to this endpoint) ----
RESUME_LLM_PROVIDER=openai            # openai (any OpenAI-compatible server) | disabled
# Default: mlx-lm on this Mac, started with
#   mlx_lm.server --model mlx-community/Qwen3-4B-Instruct-2507-4bit --port 8000
OPENAI_BASE_URL=http://127.0.0.1:8000/v1
OPENAI_MODEL=mlx-community/Qwen3-4B-Instruct-2507-4bit
# OPENAI_API_KEY=                     # only for servers that require one
RESUME_LLM_TEMPERATURE=0.1
RESUME_LLM_TIMEOUT_SECONDS=180
RESUME_LLM_MAX_RETRIES=2
RESUME_LLM_MAX_TOKENS=4096
RESUME_LLM_CONTEXT_CHAR_BUDGET=24000
# Set to true only after telling users their resume is sent to a non-local model endpoint.
RESUME_LLM_EXTERNAL_PROVIDER_ACKNOWLEDGED=false
# Evaluation only: model used by `python -m app.evaluation.judge_eval` (defaults to the provider's model).
# Prefer a different, stronger model than the generator; models grade their own output leniently.
# RESUME_JUDGE_MODEL=

# ---- Deployment ----
RESUME_DEPLOYMENT_MODE=local          # local | shared (shared requires the two secrets below)
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
RESUME_SIGNING_SECRET=change-me
# RESUME_API_AUTH_TOKEN=
FRONTEND_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
DEBUG=false

# ---- Storage and retention ----
RESUME_STORAGE_DIR=storage
RESUME_SESSION_TTL_HOURS=24
RESUME_DOWNLOAD_LINK_TTL_SECONDS=300

# ---- Upload limits ----
RESUME_MAX_UPLOAD_BYTES=5242880
RESUME_MAX_UNCOMPRESSED_BYTES=52428800
RESUME_MAX_ZIP_MEMBERS=500
RESUME_MAX_COMPRESSION_RATIO=100
RESUME_MAX_JOB_DESCRIPTION_CHARS=20000
RESUME_MAX_PROPOSALS=25

# ---- Visual fidelity gate ----
RESUME_RENDERER_ENABLED=true
RESUME_SOFFICE_PATH=soffice
RESUME_PDFTOPPM_PATH=pdftoppm
# Thresholds were calibrated on LibreOffice 24.2; other versions downgrade results to REVIEW_REQUIRED.
RESUME_RENDERER_EXPECTED_VERSION=24.2
RESUME_RENDER_DPI=100
# true = block delivery when the renderer is unavailable (instead of requiring review)
RESUME_VISUAL_GATE_REQUIRED=false

# ---- Logging ----
RESUME_LOG_LEVEL=INFO
# Never enable in production: writes resume and job text to logs.
RESUME_LOG_CONTENT=false
